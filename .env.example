# AegisForge AI Backend Environment Variables
# Copy this file to .env for local development. Do not commit real secrets.

# Resend email delivery
RESEND_API_KEY=re_your_resend_api_key_here
FROM_EMAIL=AegisForge AI <onboarding@resend.dev>

# Supabase waitlist storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
WAITLIST_TABLE=waitlist
PREVIEW_REQUESTS_TABLE=preview_requests

# Admin endpoints
ADMIN_API_KEY=replace_with_a_long_random_secret

# AI Blueprint generation (OpenAI or OpenRouter)
AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-key-here
OPENROUTER_API_KEY=sk-or-your-openrouter-key-here
AI_MODEL=gpt-4o-mini
AI_BLUEPRINTS_TABLE=ai_blueprints
AI_DAILY_FREE_LIMIT=3

# Scan reports storage
REPORTS_TABLE=scan_reports

# Optional rate-limit overrides
RATE_LIMIT_WINDOW_SECONDS=3600
WAITLIST_RATE_LIMIT=5
SCAN_RATE_LIMIT=10
QUICK_SCAN_RATE_LIMIT=20
